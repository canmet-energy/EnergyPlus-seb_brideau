{
	"name": "EnergyPlus Development",
	"build": {
		"dockerfile": "Dockerfile",
		"context": ".."
	},
	
	// Configure container settings
	"runArgs": [
		"--cap-add=SYS_PTRACE",
		"--security-opt=seccomp=unconfined"
	],
	
	// Set container environment variables
	"containerEnv": {
		"UV_PROJECT_ENVIRONMENT": "${containerWorkspaceFolder}/.venv",
		"UV_PYTHON_PREFERENCE": "managed",
		"UV_LINK_MODE": "copy", // Use copy mode for UV to avoid symlinks in the container
		"DEVCONTAINER_NODE_VERSION": "22.11.0", // Node.js version installed by install-user-nodejs.sh (override as needed)
		"DEVCONTAINER_UV_VERSION": "0.8.15", // UV (Python package manager) version installed by install-user-uv.sh
		"CCACHE_DIR": "/workspace/.ccache",
		"CMAKE_BUILD_PARALLEL_LEVEL": "4",
		"PYTHONDONTWRITEBYTECODE": "1"
	},
	
	// Mount ccache directory for faster rebuilds
	"mounts": [
		"source=${localWorkspaceFolder}/.ccache,target=/workspace/.ccache,type=bind,consistency=cached"
	],
	
	// Configure tool-specific properties
	"customizations": {
		"vscode": {
			"settings": {
				// C++ settings
				"C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
				"C_Cpp.default.cppStandard": "c++17",
				"C_Cpp.default.intelliSenseMode": "linux-gcc-x64",
				"C_Cpp.errorSquiggles": "enabled",
				
				// CMake settings
				"cmake.buildDirectory": "${workspaceFolder}/build",
				"cmake.configureOnOpen": false,
				"cmake.generator": "Ninja",
				"cmake.configureSettings": {
					"CMAKE_BUILD_TYPE": "Debug",
					"BUILD_FORTRAN": "ON",
					"BUILD_TESTING": "ON",
					"LINK_WITH_PYTHON": "ON",
					"PYTHON_CLI": "ON",
					"ENABLE_PCH": "ON",
					"DOCUMENTATION_BUILD": "DoNotBuild",
					"BUILD_PACKAGE": "OFF"
				},
				
				// Python settings
				"python.defaultInterpreterPath": "/usr/bin/python3.12",
				"python.testing.pytestEnabled": true,
				"python.testing.unittestEnabled": false,
				"python.formatting.provider": "none",
				"python.analysis.typeCheckingMode": "basic",
				
				// Editor settings
				"editor.formatOnSave": true,
				"editor.rulers": [120],
				"files.trimTrailingWhitespace": true,
				
				// Terminal settings
				"terminal.integrated.defaultProfile.linux": "bash",
				
				// Git settings
				"git.autofetch": true,
				"git.confirmSync": false
			},
			
			"extensions": [
				// C++ development
				"ms-vscode.cpptools",
				"ms-vscode.cpptools-extension-pack",
				"ms-vscode.cmake-tools",
				
				// Python development
				"ms-python.python",
				"ms-python.vscode-pylance",
				"ms-python.debugpy",
				
				// Fortran support
				"fortran-lang.linter-gfortran",
				"krvajalm.linter-gfortran",
				
				// Git and version control
				"eamodio.gitlens",
				
				// Code quality and formatting
				"xaver.clang-format",
				
				// Additional utilities
				"streetsidesoftware.code-spell-checker",
				"wayou.vscode-todo-highlight"
			]
		}
	},
	
	// Lifecycle scripts
	"postCreateCommand": "bash .devcontainer/setup.sh",
	
	// Use 'forwardPorts' to make a list of ports inside the container available locally
	"forwardPorts": [],
	
	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root
	"remoteUser": "vscode"
}
